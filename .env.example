# ============================================================================
# Market Morning Desk - environment configuration
# Copy this file to `.env` and fill in the values you have.
# NEVER commit your real .env file (it's already in .gitignore).
# ============================================================================

# --- Core mode ---
# true = run entirely on tests/fixtures/*.json, no external API keys needed.
# This is the recommended default until you've wired up real provider keys.
MOCK_MODE=true

# --- Email delivery (Section 31/47: required for the system to actually
# email you; without these, reports are still generated and saved to
# ./outbox/ so you can inspect them locally) ---
EMAIL_TO=you@example.com
EMAIL_FROM=morning-desk@yourdomain.com
EMAIL_PROVIDER=mock          # mock | resend | smtp

# Resend (recommended production email provider - https://resend.com)
RESEND_API_KEY=

# SMTP fallback (used only if EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- LLM provider (Section 25) ---
LLM_PROVIDER=mock            # mock | anthropic | openai
LLM_MODEL=claude-sonnet-5    # any current Anthropic/OpenAI model id

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Market data (optional; yfinance is used by default and needs no key,
# but is best-effort/unofficial - see README for recommended paid vendors) ---
POLYGON_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- News (optional real providers) ---
NEWSAPI_KEY=

# --- Macro data (optional; FRED is free/keyless to sign up for) ---
FRED_API_KEY=

# --- Database / logging overrides (optional) ---
DATABASE_PATH=data/market_morning_desk.db
LOG_LEVEL=INFO
